{
	"include": [
		"NetscriptDefinitions.d.ts",
		"global.d.ts",
		"src/**/*",
	],
	"compilerOptions": {
		"module": "esnext",
		"target": "esnext",
		"moduleResolution": "node",
		"skipLibCheck": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"esModuleInterop": true,
		"inlineSourceMap": true,
		"strict": true,
		"rootDir": "src/",
		"outDir": "dist/",
		"baseUrl": "src/",
		"allowJs": true,
		"paths": {
			"/*": [
				"*"
			],
			"@ns": [
				"../NetscriptDefinitions.d.ts"
			]
		}
	}
}